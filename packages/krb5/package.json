{
  "name": "@impacket/krb5",
  "version": "0.1.0",
  "description": "Kerberos v5: ASN.1, ccache, crypto, GSSAPI, keytab, pac, kpasswd (impacket krb5/*)",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@impacket/socks": "workspace:*",
    "@impacket/asn1": "workspace:*",
    "@impacket/crypto": "workspace:*",
    "@impacket/structure": "workspace:*",
    "@impacket/dcerpc": "workspace:*",
    "@impacket/spnego": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
