{
  "name": "@impacket/ldap",
  "version": "0.1.0",
  "description": "LDAP client + ASN.1 + types (impacket ldap/*)",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./src/index.ts",
