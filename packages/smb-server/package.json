{
  "name": "@impacket/smb-server",
  "version": "0.1.0",
  "description": "SMB server implementation (impacket smbserver.py)",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
