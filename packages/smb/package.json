{
  "name": "@impacket/smb",
  "version": "0.1.0",
  "description": "SMBv1 protocol (impacket smb.py)",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@impacket/asn1": "workspace:*",
    "@impacket/crypto": "workspace:*",
    "@impacket/krb5": "workspace:*",
    "@impacket/nmb": "workspace:*",
    "@impacket/ntlm": "workspace:*",
    "@impacket/spnego": "workspace:*",
    "@impacket/structure": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
