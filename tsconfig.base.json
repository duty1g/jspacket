{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "useDefineForClassFields": true,
    "paths": {
      "@impacket/asn1": ["./packages/asn1/src/index.ts"],
      "@impacket/structure": ["./packages/structure/src/index.ts"],
      "@impacket/crypto": ["./packages/crypto/src/index.ts"],
      "@impacket/uuid": ["./packages/uuid/src/index.ts"],
      "@impacket/helper": ["./packages/helper/src/index.ts"],
      "@impacket/core": ["./packages/core/src/index.ts"],
      "@impacket/nt-errors": ["./packages/nt-errors/src/index.ts"],
      "@impacket/system-errors": ["./packages/system-errors/src/index.ts"],
      "@impacket/hresult-errors": ["./packages/hresult-errors/src/index.ts"],
      "@impacket/mapi-constants": ["./packages/mapi-constants/src/index.ts"],
      "@impacket/msada-guids": ["./packages/msada-guids/src/index.ts"],
      "@impacket/nmb": ["./packages/nmb/src/index.ts"],
      "@impacket/smb": ["./packages/smb/src/index.ts"],
      "@impacket/smb3": ["./packages/smb3/src/index.ts"],
      "@impacket/smb-connection": ["./packages/smb-connection/src/index.ts"],
      "@impacket/smb-server": ["./packages/smb-server/src/index.ts"],
      "@impacket/ntlm": ["./packages/ntlm/src/index.ts"],
      "@impacket/spnego": ["./packages/spnego/src/index.ts"],
      "@impacket/negoex": ["./packages/negoex/src/index.ts"],
      "@impacket/krb5": ["./packages/krb5/src/index.ts"],
      "@impacket/dcerpc": ["./packages/dcerpc/src/index.ts"],
      "@impacket/acl": ["./packages/acl/src/index.ts"],
      "@impacket/ldap": ["./packages/ldap/src/index.ts"],
      "@impacket/mssql": ["./packages/mssql/src/index.ts"],
      "@impacket/tds": ["./packages/tds/src/index.ts"],
      "@impacket/dhcp": ["./packages/dhcp/src/index.ts"],
      "@impacket/dns": ["./packages/dns/src/index.ts"],
      "@impacket/http": ["./packages/http/src/index.ts"],
      "@impacket/dpapi": ["./packages/dpapi/src/index.ts"],
      "@impacket/ese": ["./packages/ese/src/index.ts"],
      "@impacket/winregistry": ["./packages/winregistry/src/index.ts"],
      "@impacket/impact": ["./packages/impact/src/index.ts"],
      "@impacket/ip6": ["./packages/ip6/src/index.ts"],
      "@impacket/dot11": ["./packages/dot11/src/index.ts"],
      "@impacket/pcap": ["./packages/pcap/src/index.ts"],
      "@impacket/mqtt": ["./packages/mqtt/src/index.ts"]
